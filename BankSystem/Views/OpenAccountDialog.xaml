<Window x:Class="BankSystem.Views.OpenAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Открытие нового счета" Height="350" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Открытие нового счета" FontSize="18" FontWeight="Bold" 
                   Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Тип счета:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbAccountType" Height="35">
                <ComboBoxItem Content="Текущий счет" Tag="current"/>
                <ComboBoxItem Content="Сберегательный счет" Tag="saving"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Название счета:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtAccountName" Height="35" Padding="5" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Валюта:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbCurrency" Height="35" SelectedIndex="0">
                <ComboBoxItem Content="RUB"/>
                <ComboBoxItem Content="USD"/>
                <ComboBoxItem Content="EUR"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Click="Cancel_Click" Width="100" Height="35" Margin="0,0,10,0"
                    Background="#95A5A6" Foreground="White" Cursor="Hand"/>
            <Button Content="Открыть" Click="Open_Click" Width="100" Height="35"
                    Background="#27AE60" Foreground="White" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>