<UserControl x:Class="BankSystem.Views.ClientsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BankSystem.Converters"
             Background="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление клиентами" Style="{StaticResource TitleStyle}"/>

        <!-- Панель поиска -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Tag="Поиск по ФИО, телефону или паспорту..."
                         GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"
                         KeyDown="TxtSearch_KeyDown"/>

                <Button Grid.Column="1" Content="НАЙТИ" Width="80" Height="35" 
                        Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"
                        Click="BtnSearch_Click"/>

                <Button Grid.Column="2" Content="+ ДОБАВИТЬ" Width="100" Height="35" 
                        Margin="10,0,0,0" Style="{StaticResource SuccessButton}"
                        Click="BtnAdd_Click"/>

                <Button x:Name="btnShowDeleted" Grid.Column="3" Content="🗑️ КОРЗИНА" 
                        Width="90" Height="35" Margin="10,0,0,0" Background="#95A5A6" 
                        Foreground="White" Click="BtnShowDeleted_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Таблица клиентов -->
        <DataGrid x:Name="dgClients" Grid.Row="2" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single" FontSize="12"
                  SelectionChanged="DgClients_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="ФИО / Название" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Паспорт/ИНН" Binding="{Binding PassportInn}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                <DataGridTextColumn Header="Дата регистрации" Binding="{Binding RegistrationDate, StringFormat=dd.MM.yyyy}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="txtEmpty" Grid.Row="2" Text="Клиенты не найдены" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Foreground="Gray" FontSize="14" Visibility="Collapsed"/>

        <!-- Панель действий -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button x:Name="btnEdit" Content="✏️ РЕДАКТИРОВАТЬ" Width="110" Height="35" Margin="5"
                    Background="#3498DB" Foreground="White" Click="BtnEdit_Click" IsEnabled="False"/>
            <Button x:Name="btnDelete" Content="🗑️ УДАЛИТЬ" Width="100" Height="35" Margin="5"
                    Background="#E74C3C" Foreground="White" Click="BtnDelete_Click" IsEnabled="False"/>
            <Button x:Name="btnRestore" Content="🔄 ВОССТАНОВИТЬ" Width="120" Height="35" Margin="5"
                    Background="#27AE60" Foreground="White" Click="BtnRestore_Click" IsEnabled="False"
                    Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.RowSpan="4" Background="#80FFFFFF" x:Name="loadingOverlay" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Загрузка..." FontSize="14" Foreground="{StaticResource PrimaryColor}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>