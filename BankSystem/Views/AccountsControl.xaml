<UserControl x:Class="BankSystem.Views.AccountsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление счетами" FontSize="18" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,15"/>

        <!-- Выбор клиента -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Клиент:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox x:Name="cmbClients" Grid.Column="1" Height="35" 
                          DisplayMemberPath="FullName" SelectionChanged="CmbClients_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- Статистика -->
        <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Всего счетов" Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="txtCount" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Общий баланс" Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="txtTotal" FontSize="24" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Средний баланс" Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="txtAverage" FontSize="24" FontWeight="Bold" Foreground="#F39C12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Таблица счетов -->
        <DataGrid x:Name="dgAccounts" Grid.Row="3" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название счета" Binding="{Binding AccountName}" Width="140"/>
                <DataGridTextColumn Header="Номер счета" Binding="{Binding AccountNumber}" Width="180"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding AccountType}" Width="100"/>
                <DataGridTextColumn Header="Валюта" Binding="{Binding Currency}" Width="70"/>
                <DataGridTextColumn Header="Баланс" Binding="{Binding Balance, StringFormat={}{0:N2} ₽}" Width="130"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Дата открытия" Binding="{Binding OpeningDate, StringFormat=dd.MM.yyyy}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="btnOpenAccount" Grid.Row="3" Content="+ ОТКРЫТЬ СЧЕТ" 
                Width="120" Height="35" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="0,0,0,20" Background="#27AE60" Foreground="White" 
                Click="BtnOpenAccount_Click" Visibility="Collapsed"/>

        <TextBlock x:Name="txtEmpty" Grid.Row="3" Text="Выберите клиента для просмотра счетов" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Foreground="Gray" FontSize="12" Visibility="Collapsed"/>

        <Border Grid.RowSpan="4" Background="#80FFFFFF" x:Name="loadingOverlay" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Загрузка..." FontSize="14" Foreground="#2C3E50"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>