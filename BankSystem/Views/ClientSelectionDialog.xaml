<Window x:Class="BankSystem.Views.ClientSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор клиента" Height="500" Width="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="txtSearch" Margin="0,0,0,10" Tag="Поиск клиента..."
                 GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"
                 KeyDown="TxtSearch_KeyDown"/>

        <DataGrid x:Name="dgClients" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  MouseDoubleClick="DgClients_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Паспорт/ИНН" Binding="{Binding PassportInn}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Выбрать" Width="80" Height="30" 
                    Click="BtnSelect_Click" Margin="0,0,10,0"/>
            <Button Content="Отмена" Width="80" Height="30" 
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>