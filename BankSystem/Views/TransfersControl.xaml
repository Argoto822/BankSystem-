<UserControl x:Class="BankSystem.Views.TransfersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BankSystem.Converters"
             Background="White">

    <UserControl.Resources>
        <converters:BalanceToColorConverter x:Key="BalanceToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="💸 Платежи и переводы" FontSize="18" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,15"/>

        <!-- Информация о клиенте -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="txtClientName" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock x:Name="txtClientInfo" Foreground="Gray" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🔄 Сменить клиента" Click="BtnChangeClient_Click"
                        Background="#3498DB" Foreground="White" Padding="12,8" Cursor="Hand"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Форма перевода -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Со счета:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,10"/>
                <ComboBox x:Name="cmbFromAccount" Grid.Row="0" Grid.Column="1" Height="35" Margin="0,0,0,10"
                          SelectionChanged="CmbFromAccount_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AccountNumber}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <TextBlock Text="(" Foreground="Gray"/>
                                <TextBlock Text="{Binding AccountTypeName}" Foreground="Gray"/>
                                <TextBlock Text=")" Foreground="Gray"/>
                                <TextBlock Text=" - " Foreground="Gray"/>
                                <TextBlock Text="{Binding FormattedBalance}" Foreground="{Binding Balance, Converter={StaticResource BalanceToColorConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="На счет:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,10"/>
                <ComboBox x:Name="cmbToAccount" Grid.Row="1" Grid.Column="1" Height="35" Margin="0,0,0,10">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AccountNumber}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <TextBlock Text="(" Foreground="Gray"/>
                                <TextBlock Text="{Binding AccountTypeName}" Foreground="Gray"/>
                                <TextBlock Text=")" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Сумма:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,10"/>
                <TextBox x:Name="txtAmount" Grid.Row="2" Grid.Column="1" Height="35" Padding="8" FontSize="14" TextChanged="TxtAmount_TextChanged"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Назначение:" VerticalAlignment="Top" FontWeight="SemiBold" Margin="0,0,10,10"/>
                <TextBox x:Name="txtDescription" Grid.Row="3" Grid.Column="1" Height="60" Padding="8" 
                         TextWrapping="Wrap" AcceptsReturn="True" FontSize="14"/>

                <!-- Кнопки -->
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <Button Content="💰 ПОПОЛНИТЬ" Click="BtnDeposit_Click" Width="120" Height="40" Margin="5"
                            Background="#27AE60" Foreground="White" FontWeight="Bold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="🔄 ПЕРЕВЕСТИ" Click="BtnTransfer_Click" Width="120" Height="40" Margin="5"
                            Background="#3498DB" Foreground="White" FontWeight="Bold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="🗑 ОЧИСТИТЬ" Click="BtnClear_Click" Width="120" Height="40" Margin="5"
                            Background="#95A5A6" Foreground="White" FontWeight="Bold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель погашения кредита -->
        <Border Grid.Row="3" Background="#FDEDEC" CornerRadius="8" Padding="15" Margin="0,0,0,15" 
                BorderBrush="#E74C3C" BorderThickness="1" x:Name="creditPaymentPanel" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="🏦 ПОГАШЕНИЕ КРЕДИТА" FontWeight="Bold" FontSize="14" 
                           Foreground="#E74C3C" Margin="0,0,0,10"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Кредитный счет:" Foreground="Gray" FontSize="11"/>
                    <TextBlock x:Name="txtCreditAccountNumber" FontWeight="Bold" FontSize="13" Foreground="#E74C3C"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Задолженность:" Foreground="Gray" FontSize="11"/>
                    <TextBlock x:Name="txtCreditDebt" FontWeight="Bold" FontSize="13" Foreground="#E74C3C"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💰 МИНИМАЛЬНЫЙ ПЛАТЕЖ" Click="BtnMinPayment_Click" Width="140" Height="35" Margin="5,0"
                            Background="#E67E22" Foreground="White" FontWeight="Bold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✅ ПОЛНОСТЬЮ ПОГАСИТЬ" Click="BtnFullPayment_Click" Width="140" Height="35" Margin="5,0"
                            Background="#27AE60" Foreground="White" FontWeight="Bold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                    <TextBlock Text="💡 Информация:" Foreground="Gray" FontSize="11"/>
                    <TextBlock x:Name="txtPaymentInfo" FontSize="11" Foreground="#2C3E50" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Статус -->
        <Border Grid.Row="4" Background="#F8F9FA" CornerRadius="6" Padding="10" Margin="0,0,0,15">
            <TextBlock x:Name="txtStatus" Text="Готов к выполнению операций" Foreground="Gray" FontSize="12"/>
        </Border>

        <!-- Оверлей загрузки -->
        <Border Grid.RowSpan="6" Background="#80FFFFFF" x:Name="loadingOverlay" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Загрузка..." FontSize="14" Foreground="#2C3E50"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>