<UserControl x:Class="BankSystem.Views.AdminControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BankSystem.Converters">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Администрирование системы" FontSize="18" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,20"/>

        <!-- Табы -->
        <TabControl Grid.Row="1" Margin="0,0,0,15">
            <!-- Вкладка: Пользователи -->
            <TabItem Header="👥 Пользователи">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Форма добавления пользователя с увеличенной высотой строк -->
                    <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="55"/>
                                <RowDefinition Height="55"/>
                                <RowDefinition Height="55"/>
                                <RowDefinition Height="55"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="ДОБАВЛЕНИЕ ПОЛЬЗОВАТЕЛЯ" 
                                       FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="1" Text="Логин:" VerticalAlignment="Center" FontSize="13"/>
                            <TextBox x:Name="txtNewLogin" Grid.Row="1" Grid.Column="1" Height="35" Margin="5" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtLoginError" Grid.Row="1" Grid.Column="2" Foreground="Red" FontSize="11" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Text="Пароль:" VerticalAlignment="Center" FontSize="13"/>
                            <PasswordBox x:Name="txtNewPassword" Grid.Row="2" Grid.Column="1" Height="35" Margin="5" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtPasswordError" Grid.Row="2" Grid.Column="2" Foreground="Red" FontSize="11" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Text="Email:" VerticalAlignment="Center" FontSize="13"/>
                            <TextBox x:Name="txtNewEmail" Grid.Row="3" Grid.Column="1" Height="35" Margin="5" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtEmailError" Grid.Row="3" Grid.Column="2" Foreground="Red" FontSize="11" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4" Text="Роль:" VerticalAlignment="Center" FontSize="13"/>
                            <ComboBox x:Name="cmbNewRole" Grid.Row="4" Grid.Column="1" Height="35" Margin="5" FontSize="13" VerticalAlignment="Center"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"/>

                            <CheckBox x:Name="chkIsActive" Grid.Row="4" Grid.Column="3" Content="Активен" 
                                      VerticalAlignment="Center" IsChecked="True" Margin="10,0" FontSize="13"/>

                            <Button x:Name="btnAddUser" Grid.Row="4" Grid.Column="4" Content="ДОБАВИТЬ" 
                                    Width="100" Height="35" Background="#27AE60" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                    Click="BtnAddUser_Click" Cursor="Hand" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <!-- Таблица пользователей -->
                    <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="10" Margin="0,0,15,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="СПИСОК ПОЛЬЗОВАТЕЛЕЙ" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>

                            <DataGrid x:Name="dgUsers" Grid.Row="1" AutoGenerateColumns="False" 
                                      IsReadOnly="True" SelectionMode="Single" FontSize="12"
                                      SelectionChanged="DgUsers_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                                    <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="120"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding IsActive, Converter={StaticResource BoolToStatus}}" Width="80"/>
                                    <DataGridTextColumn Header="Последний вход" Binding="{Binding LastLogin, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Панель действий -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
                        <Button x:Name="btnEditUser" Content="✏️ РЕДАКТИРОВАТЬ" Width="120" Height="35" Margin="5"
                                Background="#3498DB" Foreground="White" FontSize="12"
                                Click="BtnEditUser_Click" IsEnabled="False"/>
                        <Button x:Name="btnBlockUser" Content="🔒 БЛОКИРОВАТЬ" Width="110" Height="35" Margin="5"
                                Background="#F39C12" Foreground="White" FontSize="12"
                                Click="BtnBlockUser_Click" IsEnabled="False"/>
                        <Button x:Name="btnDeleteUser" Content="🗑️ УДАЛИТЬ" Width="100" Height="35" Margin="5"
                                Background="#E74C3C" Foreground="White" FontSize="12"
                                Click="BtnDeleteUser_Click" IsEnabled="False"/>
                        <Button x:Name="btnResetPassword" Content="🔄 СБРОС ПАРОЛЯ" Width="120" Height="35" Margin="5"
                                Background="#95A5A6" Foreground="White" FontSize="12"
                                Click="BtnResetPassword_Click" IsEnabled="False"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="* Для сброса пароля используется временный пароль '123456'" 
                               Foreground="Gray" FontSize="11" Margin="0,5,0,0"/>
                </Grid>
            </TabItem>

            <!-- Вкладка: Роли -->
            <TabItem Header="⚙ Роли">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Форма добавления роли -->
                    <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="55"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="ДОБАВЛЕНИЕ РОЛИ" 
                                       FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="1" Text="Название:" VerticalAlignment="Center" FontSize="13"/>
                            <TextBox x:Name="txtRoleName" Grid.Row="1" Grid.Column="1" Height="35" Margin="5" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Описание:" VerticalAlignment="Center" Margin="10,0" FontSize="13"/>
                            <TextBox x:Name="txtRoleDesc" Grid.Row="1" Grid.Column="3" Height="35" Margin="5" FontSize="13" VerticalAlignment="Center"/>

                            <Button x:Name="btnAddRole" Grid.Row="1" Grid.Column="4" Content="ДОБАВИТЬ" 
                                    Width="100" Height="35" Background="#27AE60" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                    Click="BtnAddRole_Click" Cursor="Hand" Margin="10,0"/>
                        </Grid>
                    </Border>

                    <!-- Таблица ролей -->
                    <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="СПИСОК РОЛЕЙ" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>

                            <DataGrid x:Name="dgRoles" Grid.Row="1" AutoGenerateColumns="False" 
                                      IsReadOnly="True" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="150"/>
                                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTemplateColumn Header="Действия" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️" Background="Transparent" 
                                                        FontSize="14" Cursor="Hand"
                                                        Click="BtnDeleteRole_Click" Tag="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Text="* Некоторые роли являются системными и не могут быть удалены" 
                               Foreground="Gray" FontSize="11" Margin="0,5,0,0"/>
                </Grid>
            </TabItem>

            <!-- Вкладка: Логи -->
            <TabItem Header="📋 Журнал действий">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Фильтры -->
                    <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Пользователь:" VerticalAlignment="Center" FontSize="13"/>
                            <ComboBox x:Name="cmbLogUser" Grid.Column="1" Height="35" Margin="5" FontSize="13"
                                      DisplayMemberPath="Login"/>

                            <TextBlock Grid.Column="2" Text="Дата от:" VerticalAlignment="Center" Margin="10,0" FontSize="13"/>
                            <DatePicker x:Name="dpLogFrom" Grid.Column="3" Height="35" Margin="5" FontSize="13"/>

                            <TextBlock Grid.Column="4" Text="до:" VerticalAlignment="Center" Margin="10,0" FontSize="13"/>
                            <DatePicker x:Name="dpLogTo" Grid.Column="5" Height="35" Margin="5" FontSize="13"/>

                            <Button x:Name="btnRefreshLogs" Grid.Column="6" Content="ОБНОВИТЬ" 
                                    Width="100" Height="35" Background="#2C3E50" Foreground="White" FontSize="12"
                                    Click="BtnRefreshLogs_Click" Cursor="Hand" Margin="10,0"/>

                            <Button x:Name="btnClearLogs" Grid.Column="7" Content="ОЧИСТИТЬ" 
                                    Width="80" Height="35" Background="#E74C3C" Foreground="White" FontSize="12"
                                    Click="BtnClearLogs_Click" Cursor="Hand" Margin="5,0"/>
                        </Grid>
                    </Border>

                    <!-- Таблица логов -->
                    <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="ЖУРНАЛ ДЕЙСТВИЙ" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>

                            <DataGrid x:Name="dgLogs" Grid.Row="1" AutoGenerateColumns="False" 
                                      IsReadOnly="True" FontSize="11">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата и время" Binding="{Binding Timestamp, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="140"/>
                                    <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="120"/>
                                    <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="150"/>
                                    <DataGridTextColumn Header="Объект" Binding="{Binding EntityType}" Width="100"/>
                                    <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="50"/>
                                    <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка: Системная информация -->
            <TabItem Header="ℹ️ О системе">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                        <TextBlock Text="БАНКОВСКАЯ СИСТЕМА" FontSize="22" FontWeight="Bold" 
                                   Foreground="White" HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Text="Версия:" FontWeight="Bold" Margin="5" FontSize="13"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="1.0.0" Margin="5" FontSize="13"/>

                            <TextBlock Grid.Row="1" Text="Разработчик:" FontWeight="Bold" Margin="5" FontSize="13"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="BankSystem Team" Margin="5" FontSize="13"/>

                            <TextBlock Grid.Row="2" Text="Технологии:" FontWeight="Bold" Margin="5" FontSize="13"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="WPF, .NET Framework 4.7.2, SQL Server" Margin="5" FontSize="13"/>

                            <TextBlock Grid.Row="3" Text="База данных:" FontWeight="Bold" Margin="5" FontSize="13"/>
                            <TextBlock x:Name="txtDbStatus" Grid.Row="3" Grid.Column="1" Text="Проверка..." Margin="5" FontSize="13"/>

                            <TextBlock Grid.Row="4" Text="Статистика:" FontWeight="Bold" Margin="5" FontSize="13"/>
                            <TextBlock x:Name="txtStats" Grid.Row="4" Grid.Column="1" Text="Загрузка..." Margin="5" FontSize="13"/>

                            <TextBlock Grid.Row="5" Text="Авторизован:" FontWeight="Bold" Margin="5" FontSize="13"/>
                            <TextBlock x:Name="txtUserInfo" Grid.Row="5" Grid.Column="1" Text="" Margin="5" FontSize="13"/>
                        </Grid>
                    </Border>

                    <Button x:Name="btnBackup" Grid.Row="2" Content="💾 СОЗДАТЬ РЕЗЕРВНУЮ КОПИЮ" 
                            Width="250" Height="40" Background="#27AE60" Foreground="White" FontSize="13" FontWeight="SemiBold"
                            Click="BtnBackup_Click" Cursor="Hand" Margin="0,10"/>

                    <TextBlock Grid.Row="3" Text="© 2024 Банковская система. Все права защищены." 
                               Foreground="Gray" FontSize="11" HorizontalAlignment="Center" Margin="0,20"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.RowSpan="3" Background="#80FFFFFF" x:Name="loadingOverlay" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Загрузка..." FontSize="14" Foreground="#2C3E50"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>