<UserControl x:Class="BankSystem.Views.AdminControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <UserControl.Resources>
        <Style TargetType="TextBox" x:Key="InputStyle">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="PasswordBox" x:Key="PasswordStyle">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Администрирование системы" FontSize="20" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,20"/>

        <!-- Форма добавления пользователя -->
        <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="➕ ДОБАВЛЕНИЕ ПОЛЬЗОВАТЕЛЯ" 
                           FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,15"/>

                <TextBlock Grid.Row="1" Text="Логин:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtLogin" Grid.Row="1" Grid.Column="1" Style="{StaticResource InputStyle}"/>

                <TextBlock Grid.Row="2" Text="Пароль:" VerticalAlignment="Center"/>
                <PasswordBox x:Name="txtPassword" Grid.Row="2" Grid.Column="1" Style="{StaticResource PasswordStyle}"/>

                <TextBlock Grid.Row="3" Text="Email:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtEmail" Grid.Row="3" Grid.Column="1" Style="{StaticResource InputStyle}"/>

                <TextBlock Grid.Row="4" Text="Роль:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbRole" Grid.Row="4" Grid.Column="1" 
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          Margin="0,0,10,0"/>

                <Button Grid.Row="4" Grid.Column="2" Content="➕ ДОБАВИТЬ" Width="100" Height="35"
                        Background="#27AE60" Foreground="White" FontWeight="Bold"
                        Click="BtnAddUser_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Список пользователей -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E5E8E8" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="👥 СПИСОК ПОЛЬЗОВАТЕЛЕЙ" FontWeight="Bold" 
                           Foreground="#2C3E50" Margin="15,10,0,10"/>

                <DataGrid x:Name="dgUsers" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" FontSize="12" 
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionChanged="DgUsers_SelectionChanged"
                          Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="120"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80"/>
                        <DataGridTextColumn Header="Последний вход" Binding="{Binding LastLogin, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Кнопки управления пользователем -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" Margin="0,0,10,10">
            <Button x:Name="btnResetPassword" Content="🔑 СБРОС ПАРОЛЯ" Width="120" Height="30"
                    Background="#F39C12" Foreground="White" FontWeight="Bold"
                    Click="BtnResetPassword_Click" IsEnabled="False" Margin="0,0,10,0"/>
            <Button x:Name="btnBlock" Content="🔒 ЗАБЛОКИРОВАТЬ" Width="110" Height="30"
                    Background="#E74C3C" Foreground="White" FontWeight="Bold"
                    Click="BtnBlock_Click" IsEnabled="False" Margin="0,0,10,0"/>
            <Button x:Name="btnUnblock" Content="🔓 АКТИВИРОВАТЬ" Width="110" Height="30"
                    Background="#27AE60" Foreground="White" FontWeight="Bold"
                    Click="BtnUnblock_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- Индикатор загрузки -->
        <Border Background="#80FFFFFF" x:Name="loadingOverlay" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Загрузка..." FontSize="14" Foreground="#2C3E50"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>