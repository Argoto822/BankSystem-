<UserControl x:Class="BankSystem.Views.CreditCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:BankSystem.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="White">

    <UserControl.Resources>
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с калькулятором -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Сумма кредита -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="10">
                    <TextBlock Text="💰 Сумма кредита (₽)" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding CreditAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" 
                             Background="White" Foreground="Black" FontSize="14" Padding="8" BorderThickness="0"/>
                </StackPanel>

                <!-- Процентная ставка -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10">
                    <TextBlock Text="📈 Процентная ставка (%)" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding InterestRate, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}" 
                             Background="White" Foreground="Black" FontSize="14" Padding="8" BorderThickness="0"/>
                </StackPanel>

                <!-- Срок кредита -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="10">
                    <TextBlock Text="📅 Срок (месяцев)" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding TermMonths, UpdateSourceTrigger=PropertyChanged}" 
                             Background="White" Foreground="Black" FontSize="14" Padding="8" BorderThickness="0"/>
                </StackPanel>

                <!-- Тип платежа -->
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="10">
                    <TextBlock Text="🔄 Тип платежа" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding PaymentType}" 
                              Background="White" Foreground="Black" FontSize="14" Padding="8" Height="38"/>
                </StackPanel>

                <!-- Результаты расчета -->
                <Border Grid.Row="1" Grid.ColumnSpan="4" Background="#34495E" CornerRadius="6" Padding="15" Margin="10,10,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="📊 Ежемесячный платеж" Foreground="#BDC3C7" FontSize="12"/>
                            <TextBlock Text="{Binding MonthlyPayment, StringFormat={}{0:N2} ₽}" 
                                       Foreground="#2ECC71" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="💰 Общая сумма выплат" Foreground="#BDC3C7" FontSize="12"/>
                            <TextBlock Text="{Binding TotalPayments, StringFormat={}{0:N2} ₽}" 
                                       Foreground="#F39C12" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="💸 Переплата по процентам" Foreground="#BDC3C7" FontSize="12"/>
                            <TextBlock Text="{Binding TotalInterest, StringFormat={}{0:N2} ₽}" 
                                       Foreground="#E74C3C" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="📈 Эффективная ставка" Foreground="#BDC3C7" FontSize="12"/>
                            <TextBlock Text="{Binding EffectiveRate, StringFormat={}{0:F2}%}" 
                                       Foreground="#3498DB" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Нижняя часть с графиком платежей -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок графика -->
                <Border Grid.Row="0" Background="#ECF0F1" Padding="10" CornerRadius="8,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 ГРАФИК ПЛАТЕЖЕЙ" FontWeight="Bold" FontSize="16" Foreground="#2C3E50"/>
                        <TextBlock Text="{Binding StatusMessage}" Margin="20,0,0,0" Foreground="#7F8C8D" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <Button x:Name="btnIssueCredit" Content="💰 Оформить кредит" 
                                    Click="BtnIssueCredit_Click"
                                    Background="#E74C3C" 
                                    Foreground="White" 
                                    Padding="10,5" 
                                    Margin="5"
                                    Cursor="Hand"
                                    FontSize="12"/>
                            <Button x:Name="btnExportExcel" Content="📊 Экспорт в Excel" 
                                    Click="BtnExportExcel_Click"
                                    Background="#27AE60" 
                                    Foreground="White" 
                                    Padding="10,5" 
                                    Margin="5"
                                    Cursor="Hand"
                                    FontSize="12"/>
                            <Button x:Name="btnPrint" Content="🖨 Печать" 
                                    Click="BtnPrint_Click"
                                    Background="#3498DB" 
                                    Foreground="White" 
                                    Padding="10,5" 
                                    Margin="5"
                                    Cursor="Hand"
                                    FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Статистика по платежам -->
                <Border Grid.Row="1" Background="#F8F9FA" Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="12" Height="12" Fill="Green" Margin="0,0,5,0" RadiusX="2" RadiusY="2"/>
                            <TextBlock Text="Оплаченные" FontSize="11" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="12" Height="12" Fill="Orange" Margin="0,0,5,0" RadiusX="2" RadiusY="2"/>
                            <TextBlock Text="Ожидают оплаты" FontSize="11" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Оплачено: " FontSize="11" Foreground="#555"/>
                            <TextBlock Text="{Binding PaidCount}" FontSize="11" FontWeight="Bold" Foreground="Green"/>
                            <TextBlock Text=" из " FontSize="11" Foreground="#555"/>
                            <TextBlock Text="{Binding TotalPaymentsCount}" FontSize="11" FontWeight="Bold" Foreground="#555"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Остаток долга: " FontSize="11" Foreground="#555"/>
                            <TextBlock Text="{Binding RemainingTotal, StringFormat={}{0:N2} ₽}" FontSize="11" FontWeight="Bold" Foreground="#E74C3C"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Таблица графика платежей -->
                <DataGrid Grid.Row="2" 
                          ItemsSource="{Binding PaymentSchedule}" 
                          SelectedItem="{Binding SelectedPayment}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          AlternatingRowBackground="#F9F9F9"
                          FontSize="12"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          RowHeight="35">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#34495E"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ платежа" Binding="{Binding PaymentNumber}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Дата платежа" Binding="{Binding PaymentDate, StringFormat=dd.MM.yyyy}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Сумма платежа" Binding="{Binding PaymentAmount, StringFormat={}{0:N2} ₽}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2980B9"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Основной долг" Binding="{Binding PrincipalAmount, StringFormat={}{0:N2} ₽}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Проценты" Binding="{Binding InterestAmount, StringFormat={}{0:N2} ₽}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Остаток долга" Binding="{Binding RemainingDebt, StringFormat={}{0:N2} ₽}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Статус" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsPaid, Converter={StaticResource BoolToStatusConverter}}"
                                               Foreground="{Binding IsPaid, Converter={StaticResource BoolToColorConverter}}"
                                               HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>