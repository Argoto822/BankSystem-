<Window x:Class="BankSystem.Views.DepositDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💰 Пополнение счета" Height="450" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="💰" FontSize="28" Margin="0,0,10,0"/>
            <TextBlock Text="Пополнение счета" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
        </StackPanel>

        <!-- Информация о выбранном счете -->
        <Border Grid.Row="1" Background="#E8F4FD" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🏦" FontSize="24" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="txtAccountInfo" Text="Выберите счет" 
                               FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock x:Name="txtCurrentBalance" Text="Текущий баланс: 0.00 ₽" 
                               FontSize="12" Foreground="#7F8C8D" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Выбор счета -->
        <TextBlock Grid.Row="2" Text="Выберите счет для пополнения:" Style="{StaticResource LabelStyle}"/>
        <ComboBox x:Name="cmbAccount" Grid.Row="3" 
                  DisplayMemberPath="FullDisplayName"
                  SelectionChanged="CmbAccount_SelectionChanged"
                  VerticalContentAlignment="Center"/>

        <!-- Сумма пополнения -->
        <TextBlock Grid.Row="4" Text="Сумма пополнения (₽):" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="txtAmount" Grid.Row="5" 
                 Text="0" 
                 TextAlignment="Right"
                 PreviewTextInput="TxtAmount_PreviewTextInput"
                 PreviewKeyDown="TxtAmount_PreviewKeyDown"/>

        <!-- Предустановленные суммы -->
        <WrapPanel Grid.Row="6" Margin="0,0,0,20">
            <Button Content="1 000 ₽" Width="80" Height="30" Margin="0,0,10,5"
                    Background="#ECF0F1" Foreground="#2C3E50" 
                    Click="QuickAmount_Click" Cursor="Hand"/>
            <Button Content="5 000 ₽" Width="80" Height="30" Margin="0,0,10,5"
                    Background="#ECF0F1" Foreground="#2C3E50" 
                    Click="QuickAmount_Click" Cursor="Hand"/>
            <Button Content="10 000 ₽" Width="80" Height="30" Margin="0,0,10,5"
                    Background="#ECF0F1" Foreground="#2C3E50" 
                    Click="QuickAmount_Click" Cursor="Hand"/>
            <Button Content="50 000 ₽" Width="80" Height="30" Margin="0,0,10,5"
                    Background="#ECF0F1" Foreground="#2C3E50" 
                    Click="QuickAmount_Click" Cursor="Hand"/>
            <Button Content="100 000 ₽" Width="90" Height="30" Margin="0,0,10,5"
                    Background="#ECF0F1" Foreground="#2C3E50" 
                    Click="QuickAmount_Click" Cursor="Hand"/>
        </WrapPanel>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="✅ ПОПОЛНИТЬ" Width="130" Height="40" 
                    Background="#27AE60" Foreground="White" 
                    Style="{StaticResource ActionButton}"
                    Click="BtnDeposit_Click" Margin="0,0,10,0"
                    Cursor="Hand"/>
            <Button Content="❌ ОТМЕНА" Width="100" Height="40" 
                    Background="#95A5A6" Foreground="White" 
                    Style="{StaticResource ActionButton}"
                    Click="BtnCancel_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>