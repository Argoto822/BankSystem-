<UserControl x:Class="BankSystem.Views.ReportsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BankSystem.Converters"
             Background="White">

    <UserControl.Resources>
        <converters:BalanceToColorConverter x:Key="BalanceToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📊 Формирование отчетов" FontSize="18" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,15"/>

        <!-- Фильтры -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Клиент -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Клиент:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,10"/>
                <ComboBox x:Name="cmbClients" Grid.Row="0" Grid.Column="1" Height="35" Margin="0,0,10,10"
                          DisplayMemberPath="FullName" SelectionChanged="CmbClients_SelectionChanged"/>

                <!-- Счет -->
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Счет:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,10"/>
                <ComboBox x:Name="cmbAccounts" Grid.Row="0" Grid.Column="3" Height="35" Margin="0,0,10,10"
                          SelectionChanged="CmbAccounts_SelectionChanged" IsEnabled="False">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AccountNumber}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <TextBlock Text="(" Foreground="Gray"/>
                                <TextBlock Text="{Binding AccountTypeName}" Foreground="Gray"/>
                                <TextBlock Text=")" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Период -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Период:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,10"/>
                <DatePicker x:Name="dpStartDate" Grid.Row="1" Grid.Column="1" Height="35" Margin="0,0,10,10"
                            SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="по:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,10"/>
                <DatePicker x:Name="dpEndDate" Grid.Row="1" Grid.Column="3" Height="35" Margin="0,0,10,10"
                            SelectedDateChanged="DatePicker_SelectedDateChanged"/>

                <!-- Кнопки -->
                <StackPanel Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🔄 Обновить" Click="BtnRefresh_Click" Width="100" Height="35" Margin="5,0"
                            Background="#3498DB" Foreground="White" Cursor="Hand"/>
                    <Button Content="📊 Экспорт" Click="BtnExport_Click" Width="100" Height="35" Margin="5,0"
                            Background="#27AE60" Foreground="White" Cursor="Hand"/>
                    <Button Content="🖨 Печать" Click="BtnPrint_Click" Width="100" Height="35" Margin="5,0"
                            Background="#F39C12" Foreground="White" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Информация о выбранном счете -->
        <Border Grid.Row="2" Background="#E8F8F5" CornerRadius="8" Padding="15" Margin="0,0,0,15" 
                BorderBrush="#1ABC9C" BorderThickness="1" x:Name="accountInfoPanel" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🏦" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Счет:" FontWeight="SemiBold" Margin="0,0,5,0"/>
                    <TextBlock x:Name="txtAccountNumber" FontWeight="Bold" Margin="0,0,15,0"/>
                    <TextBlock Text="Тип:" FontWeight="SemiBold" Margin="0,0,5,0"/>
                    <TextBlock x:Name="txtAccountType" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Баланс:" FontWeight="SemiBold" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtAccountBalance" Grid.Column="3" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Статистика -->
        <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#E8F8F5" CornerRadius="6" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📈 Поступления" Foreground="#16A085" FontSize="12" TextAlignment="Center"/>
                        <TextBlock x:Name="txtIncomes" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#27AE60" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#FDEDEC" CornerRadius="6" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📉 Расходы" Foreground="#E74C3C" FontSize="12" TextAlignment="Center"/>
                        <TextBlock x:Name="txtExpenses" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#E74C3C" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#FEF9E7" CornerRadius="6" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="💰 Баланс" Foreground="#F39C12" FontSize="12" TextAlignment="Center"/>
                        <TextBlock x:Name="txtBalance" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#F39C12" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#EBF5FB" CornerRadius="6" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="🔄 Всего операций" Foreground="#2980B9" FontSize="12" TextAlignment="Center"/>
                        <TextBlock x:Name="txtTransactionsCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#2980B9" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Таблица транзакций -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="dgTransactions" AutoGenerateColumns="False" IsReadOnly="True"
                          FontSize="12" AlternatingRowBackground="#F9F9F9" GridLinesVisibility="Horizontal"
                          RowHeight="35">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} ₽}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding Amount, Converter={StaticResource BalanceToColorConverter}}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="От кого" Binding="{Binding FromAccount}" Width="150"/>
                        <DataGridTextColumn Header="Кому" Binding="{Binding ToAccount}" Width="150"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="txtEmptyTransactions" Text="Нет транзакций за выбранный период" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Foreground="Gray" FontSize="12" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Оверлей загрузки -->
        <Border Grid.RowSpan="5" Background="#80FFFFFF" x:Name="loadingOverlay" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Загрузка..." FontSize="14" Foreground="#2C3E50"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>