<UserControl x:Class="BankSystem.Views.ReportsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Формирование отчетов" FontSize="18" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,20"/>

        <!-- Параметры отчета -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Клиент -->
                <TextBlock Grid.Row="0" Text="Клиент:" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox x:Name="cmbClients" Grid.Row="0" Grid.Column="1" Height="32" Margin="5,5"
                          DisplayMemberPath="FullName" SelectionChanged="CmbClients_SelectionChanged"/>

                <!-- Счет -->
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Счет:" VerticalAlignment="Center" Margin="15,5,0,5"/>
                <ComboBox x:Name="cmbAccounts" Grid.Row="0" Grid.Column="3" Height="32" Margin="5,5"
                          DisplayMemberPath="DisplayName" SelectionChanged="CmbAccounts_SelectionChanged"/>

                <!-- Период -->
                <TextBlock Grid.Row="1" Text="Период:" VerticalAlignment="Center" Margin="0,5"/>
                <DatePicker x:Name="dpDateFrom" Grid.Row="1" Grid.Column="1" Height="32" Margin="5,5" 
                            SelectedDateChanged="DatePicker_SelectedDateChanged"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="по:" VerticalAlignment="Center" Margin="15,5,0,5"/>
                <DatePicker x:Name="dpDateTo" Grid.Row="1" Grid.Column="3" Height="32" Margin="5,5"
                            SelectedDateChanged="DatePicker_SelectedDateChanged"/>

                <!-- Кнопки -->
                <Button Grid.Row="0" Grid.Column="8" Content="СФОРМИРОВАТЬ" Width="120" Height="35"
                        Margin="15,5,0,5" Background="#2C3E50" Foreground="White" 
                        Click="BtnGenerate_Click" Cursor="Hand"/>

                <Button Grid.Row="1" Grid.Column="8" Content="📄 ЭКСПОРТ CSV" Width="120" Height="35"
                        Margin="15,5,0,5" Background="#FF008000" Foreground="White" 
                        Click="BtnExportPdf_Click" Cursor="Hand" x:Name="btnExportPdf" IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- Статистика -->
        <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="5" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ПОСТУПЛЕНИЯ" Foreground="Gray" FontSize="11"/>
                    <TextBlock x:Name="txtIncome" FontSize="18" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="РАСХОДЫ" Foreground="Gray" FontSize="11"/>
                    <TextBlock x:Name="txtExpense" FontSize="18" FontWeight="Bold" Foreground="#E74C3C"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="ОБОРОТ" Foreground="Gray" FontSize="11"/>
                    <TextBlock x:Name="txtTurnover" FontSize="18" FontWeight="Bold" Foreground="#F39C12"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="КОЛИЧЕСТВО" Foreground="Gray" FontSize="11"/>
                    <TextBlock x:Name="txtCount" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Таблица операций -->
        <DataGrid x:Name="dgTransactions" Grid.Row="3" AutoGenerateColumns="False" 
                  IsReadOnly="True" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="120"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="Со счета" Binding="{Binding FromAccount}" Width="150"/>
                <DataGridTextColumn Header="На счет" Binding="{Binding ToAccount}" Width="150"/>
                <DataGridTextColumn Header="Сумма" Width="100">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Amount" StringFormat="{}{0:N2} ₽"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Назначение" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="txtEmpty" Grid.Row="3" Text="Выберите счет для формирования отчета" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Foreground="Gray" FontSize="12" Visibility="Collapsed"/>

        <Border Grid.RowSpan="4" Background="#80FFFFFF" x:Name="loadingOverlay" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Загрузка..." FontSize="14" Foreground="#2C3E50"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>